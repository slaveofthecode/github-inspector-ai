# GitHub Personal Access Token (optional but recommended).
# Raises the API rate limit from 60 to 5,000 requests/hour.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=<value>

# Public site URL (used for Open Graph / social previews in app/layout.tsx).
# Update here if the deployed URL changes.
NEXT_PUBLIC_SITE_URL='https://main.d22y0lq8a3u6xm.amplifyapp.com'

# Create an API KEY from your account
# https://aistudio.google.com/ 
GEMINI_API_KEY=<value>
GEMINI_MODEL=<value>